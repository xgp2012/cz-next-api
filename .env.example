# ============================================================================
# One API（cz-next-api）环境变量示例
#
# 复制为 .env 后按需修改。注意：所有支付/分成相关密钥**只走环境变量**，
# 不会写入 options 表（该表会被 /api/option 明文读取）。
# ============================================================================

PORT=3000
DEBUG=false
HTTPS_PROXY=http://localhost:7890

# ---- 基础 ----
# SESSION_SECRET=please-change-me
# SQL_DSN=                      # 留空使用 SQLite（./one-api.db 或 SQLITE_PATH）
# SQLITE_PATH=./one-api.db
# REDIS_CONN_STRING=            # 留空则用内存限流
# QUOTA_PER_UNIT=500000         # 1 美元 = 多少额度
# SERVER_ADDRESS=http://localhost:3000

# ---- 在线充值（EPay 协议）----
# PAY_ADDRESS=https://pay.example.com
# EPAY_ID=1001
# EPAY_KEY=your-epay-key
# PAY_METHODS=alipay,wxpay
# AMOUNT_OPTIONS=10,20,50,100,200,500
# MIN_TOP_UP=1
# MAX_WALLET_QUOTA=0            # 0 = 不限
# CUSTOM_CALLBACK_ADDRESS=https://api.example.com
# TOPUP_ORDER_EXPIRE_MINUTES=30

# ---- 通用 webhook 网关（HMAC-SHA256）----
# WEBHOOK_SECRET=your-hmac-secret

# ---- 邀请分成 ----
# AFF_COMMISSION_ENABLED=false  # 总开关，默认关闭
# AFF_COMMISSION_RATE=0.05      # 5%
# AFF_COMMISSION_MIN_QUOTA=0    # 单笔低于该额度不计佣金
# AFF_MIN_TRANSFER_QUOTA=0      # 转正门槛（额度），0 = 回落为 1 美元等值额度
